# Copy this file to .env and fill in your real key.
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides (defaults live in config/settings.py)
# Note: gemini-2.5-flash (the default) is retired for new API keys;
# gemini-3.5-flash-lite is the tested working alternative.
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_TEMPERATURE=0.2
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TIMEOUT_SECONDS=60
# LLM_RETRY_COUNT=3
# LLM_BACKEND=gemini
