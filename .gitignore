# Secrets - never commit credentials of any kind
.env
.env.*
!.env.example
*.key
*.pem
*_credentials*
credentials*.json
secrets*
apikey*
token*.txt

# FinanceBench dataset clone (672 MB of PDFs; re-fetch from github.com/patronus-ai/financebench)
financebench/

# Copied evaluation PDFs (regenerate with scripts/build_ground_truth.py)
data/raw_statements/*.pdf

# Ad-hoc documents uploaded through the Streamlit app's "Upload PDF" feature
# (app.py names these "upload_<filename>"). These are manual test artifacts,
# not part of the reproducible FinanceBench research dataset, and may
# contain personal/sensitive content depending on what was uploaded.
data/processed/upload_*
data/clean_text_backup/upload_*
outputs/responses/upload_*

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Local artifacts
*.log
